page {
  min-height: 100%;
  background: #07130f;
  color: #f1f6f2;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button::after { border: none; }

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 64rpx;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid #21362c;
  border-radius: 28rpx;
  background: #0d1d16;
  padding: 28rpx;
}

.muted { color: #819389; }
.lime { color: #b8ff38; }
.danger { color: #ff6b66; }

.primary-button {
  margin: 0;
  border-radius: 22rpx;
  background: #b8ff38;
  color: #07130f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.secondary-button {
  margin: 0;
  border: 1rpx solid #2c4539;
  border-radius: 22rpx;
  background: #13261d;
  color: #f1f6f2;
  font-size: 28rpx;
  line-height: 84rpx;
}

.field {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin-top: 14rpx;
  border: 1rpx solid #294237;
  border-radius: 18rpx;
  background: #091710;
  padding: 0 22rpx;
  color: #f1f6f2;
  font-size: 30rpx;
}
