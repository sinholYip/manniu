# 统一换行符，避免跨设备协作时整文件 diff
* text=auto eol=lf

# Windows 批处理与 PowerShell 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Gradle wrapper 脚本
gradlew text eol=lf
gradlew.bat text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.apk binary
*.jar binary
*.zip binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
